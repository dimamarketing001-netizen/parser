# Copy to /etc/parsya-control.env and replace every placeholder.
PARSYA_ADMIN_USER=admin
PARSYA_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
PARSYA_SECRET_KEY=REPLACE_WITH_OPENSSL_RANDOM_HEX_32
PARSYA_WORKER_TOKEN=REPLACE_WITH_DIFFERENT_OPENSSL_RANDOM_HEX_32
PARSYA_COOKIE_SECURE=1
PARSYA_DATA_DIR=/var/lib/parsya-control
PARSYA_SQLITE_PATH=/var/lib/parsya-control/control.sqlite3
