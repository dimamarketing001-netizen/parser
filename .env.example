# Copy to /etc/parsya-control.env and replace every placeholder.
PARSYA_ADMIN_USER=admin
PARSYA_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
PARSYA_SECRET_KEY=REPLACE_WITH_OPENSSL_RANDOM_HEX_32
PARSYA_WORKER_TOKEN=REPLACE_WITH_DIFFERENT_OPENSSL_RANDOM_HEX_32
PARSYA_COOKIE_SECURE=1
PARSYA_DATA_DIR=/var/lib/parsya-control
PARSYA_SQLITE_PATH=/var/lib/parsya-control/control.sqlite3
# Optional: enables server-to-server access to the read-only /api/v1/* JSON API via the
# X-API-Key header. Marketer users instead log in with email/password at
# /api/v1/auth/login (accounts created from the "Пользователи SaaS" admin page) and use
# the bearer token that returns; this key is for tooling, not the browser frontend.
# Leave empty to disable key-based access (user login still works either way).
PARSYA_PUBLIC_API_TOKEN=REPLACE_WITH_A_THIRD_DIFFERENT_OPENSSL_RANDOM_HEX_32
# Optional, comma-separated: origins (scheme+host) allowed to call /api/v1/* with CORS,
# e.g. the domain the SaaS frontend is deployed on. Leave empty if the frontend is served
# from the same origin as this API (no CORS needed then).
PARSYA_FRONTEND_ORIGINS=
